{
  "name": "loom",
  "version": "0.1.0",
  "description": "A local scientific writing workspace — LaTeX source, builds and PDF",
  "desktopName": "org.loom.workspace.desktop",
  "author": "Loom contributors",
  "private": true,
  "main": "out/main/index.js",
  "packageManager": "npm@11.19.0",
  "engines": {
    "node": "^22.12.0 || ^24.0.0 || >=26.0.0",
    "npm": ">=11"
  },
  "scripts": {
    "dev": "electron-vite dev",
    "dev:ui": "vite --config vite.renderer.config.mts --host 127.0.0.1",
    "start": "electron-vite preview",
    "format": "prettier --write src tests scripts examples *.ts *.mts *.json README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md .github",
    "format:check": "prettier --check src tests scripts examples *.ts *.mts *.json README.md CONTRIBUTING.md CODE_OF_CONDUCT.md SECURITY.md .github",
    "typecheck": "tsc --noEmit -p tsconfig.json",
    "test": "vitest run",
    "test:e2e": "playwright test",
    "check": "npm run format:check && npm run typecheck && npm test && npm run test:linux-release && npm run build",
    "build": "electron-vite build",
    "package": "npm run build && electron-builder --linux dir",
    "package:appimage": "npm run build && electron-builder --linux AppImage --publish never",
    "linux:checksum": "node scripts/linux-release-checksum.mjs create",
    "linux:verify-checksum": "node scripts/linux-release-checksum.mjs verify",
    "test:linux-release": "node --test scripts/linux-release-checksum.test.mjs",
    "try:phase3": "node scripts/try-phase-3.mjs",
    "try:phase7": "node scripts/try-phase-7.mjs",
    "workload:phase8": "node scripts/phase-8-workload.mjs",
    "bench:phase8": "playwright test tests/e2e/phase8-workload.spec.ts",
    "setup:latex": "node scripts/setup-latex.mjs"
  },
  "dependencies": {
    "@codemirror/autocomplete": "6.20.4",
    "@codemirror/commands": "6.11.1",
    "@codemirror/language": "6.13.1",
    "@codemirror/legacy-modes": "6.5.5",
    "@codemirror/lint": "6.9.7",
    "@codemirror/search": "6.7.2",
    "@codemirror/state": "6.7.6",
    "@codemirror/view": "6.43.15",
    "@lezer/highlight": "1.2.5",
    "@opencode-ai/sdk": "1.19.5",
    "codemirror": "6.0.2",
    "diff": "9.0.0",
    "fflate": "0.8.3",
    "pdfjs-dist": "6.5.438",
    "solid-js": "1.9.18",
    "y-codemirror.next": "0.3.6",
    "y-indexeddb": "9.0.12",
    "yjs": "13.6.33",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.64.1",
    "@swc/core": "1.16.21",
    "@types/node": "26.6.6",
    "electron": "45.2.1",
    "electron-builder": "26.18.0",
    "electron-vite": "6.0.0",
    "prettier": "3.9.10",
    "typescript": "6.0.3",
    "vite": "8.3.5",
    "vite-plugin-solid": "2.11.15",
    "vitest": "5.1.0"
  },
  "build": {
    "appId": "org.loom.workspace",
    "productName": "Loom",
    "directories": {
      "output": "release"
    },
    "files": [
      "out/**/*",
      "package.json"
    ],
    "linux": {
      "icon": "design/brand/loom-app-icon.png",
      "target": [
        "dir"
      ],
      "category": "Office",
      "executableName": "loom",
      "executableArgs": [],
      "extraFiles": [
        {
          "from": "scripts/linux-app-run.sh",
          "to": "AppRun"
        }
      ],
      "syncDesktopName": true
    },
    "extraResources": [
      {
        "from": "examples/phase-3/multi-file",
        "to": "examples/phase-3/multi-file"
      },
      {
        "from": "examples/phase-3/biber",
        "to": "examples/phase-3/biber"
      },
      {
        "from": "examples/phase-3/bibtex",
        "to": "examples/phase-3/bibtex"
      },
      {
        "from": "examples/phase-3/ambiguous",
        "to": "examples/phase-3/ambiguous"
      },
      {
        "from": "examples/phase-3/broken",
        "to": "examples/phase-3/broken"
      },
      {
        "from": "examples/phase-3/missing-package",
        "to": "examples/phase-3/missing-package"
      }
    ]
  },
  "license": "MIT"
}
